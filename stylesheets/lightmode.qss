QWidget {
    background-color: #f5f5f5;
    border: none;
    padding: 0px;
    color: #222222;
    selection-background-color: #cce4ff;
    selection-color: #222222;
}

QCheckBox {
    background-color: #f5f5f5;
    color: #222222;
    spacing: 4px;
    outline: none;
    padding-top: 4px;
    padding-bottom: 4px;
}

QToolBox QScrollArea {
    padding: 0px;
    border: 0px;
}

.QFrame {
    border-radius: 4px;
    border: 1px solid #e0e0e0;
}

QPushButton {
    background-color: #e0e0e0;
    color: #222222;
    padding: 2px;
    outline: none;
    border: none;
}

QPushButton:disabled {
    background-color: #e0e0e0;
    color: #bdbdbd;
    padding: 2px;
}

QPushButton:checked {
    background-color: #bbdefb;
    padding: 2px;
    outline: none;
}

QPushButton:checked:disabled {
    background-color: #bbdefb;
    color: #bdbdbd;
    padding: 2px;
    outline: none;
}

QPushButton:checked:selected {
    background: #bbdefb;
}

QPushButton:hover {
    background-color: #cce4ff;
    color: #222222;
}

QPushButton:pressed {
    background-color: #bbdefb;
}

QPushButton:selected {
    background: #bbdefb;
    color: #222222;
}

QPushButton::menu-indicator {
    bottom: 4px;
}

QTabWidget {
    padding: 2px;
    selection-background-color: #e0e0e0;
}

QTabWidget QWidget::tab{
        background-color: #e0e0e0;
}

QTabWidget QWidget::tab:selected {
    background-color: #cce4ff;
}

QTabWidget::pane {
    border: 1px solid #e0e0e0;
    margin: 0px;
    padding: 0px;
}

QTabWidget::pane:selected {
    background-color: #e0e0e0;
    border: 1px solid #cce4ff;
}

QTextBrowser {
    background-color: #e1e0e0;
    border: 1px solid #e0e0e0;
    color: #222222;
    border-radius: 4px;
}

QLineEdit {
    background-color: #ffffff;
    border-style: solid;
    border: 1px solid #e0e0e0;
    color: #222222;
}

QComboBox {
    border: 1px solid #e0e0e0;
    selection-background-color: #cce4ff;
    padding-left: 4px;
    padding-right: 4px;
    min-height: 1.5em;
}

QComboBox::indicator {
    border: none;
    border-radius: 0;
    background-color: transparent;
    selection-background-color: transparent;
    color: transparent;
    selection-color: transparent;
}

QComboBox::indicator:alternate {
    background: #f5f5f5;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 12px;
    border-left: 1px solid #e0e0e0;
}

QComboBox::down-arrow {
    image: url("imgs/down_arrow_light.png");
    height: 8px;
    width: 8px;
}

QComboBox:hover {
    border: 1px solid #cce4ff;
}

QComboBox:focus {
    border: 1px solid #1976d2;
}

QComboBox:on {
    selection-background-color: #cce4ff;
}

QComboBox::item:alternate {
    background: #f5f5f5;
}

QComboBox QAbstractItemView {
    border: 1px solid #e0e0e0;
    border-radius: 0;
    background-color: #f5f5f5;
    selection-background-color: #cce4ff;
}

QComboBox QAbstractItemView:selected {
    background: #cce4ff;
    color: #e0e0e0;
}

QTabBar, QDockWidget QTabBar {
    qproperty-drawBase: 0;
    border-radius: 4px;
    margin: 0px;
    padding: 2px;
    border: 0;
}

QWidget:disabled {
  color: #adadad; 
}

QPushButton#ToggleButton{
    background-color: #d3e8f3ff;
    border: 1px solid #dadada;
    border-radius: 2px;
    padding-top: 6px;
    padding-bottom: 6px;
    font-weight: bold;
}

QScrollBar:vertical {
    background: #b0b0b0;
    width: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #cecccc;
    min-height: 20px;
    border-radius: 6px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
    border: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: #b0b0b0;
    height: 12px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #e0e0e0;
    min-width: 20px;
    border-radius: 6px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
    background: none;
    border: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

QWidget#Panel_L{
  border: none;
  border-right: 2px solid #bdbdbd;
}

QWidget#Panel_R{
  border: none;
}

QScrollArea#pgnInputs {
  border: 1px solid #b7b7b7;
}

QMessageBox QPushButton {
  padding: 6px 12px;
  min-width: 80px;
}

QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 2px;
    color: #222222;
    padding: 2px 4px;
    selection-background-color: #cce4ff;
    selection-color: #222222;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #1976d2;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    background-color: #e0e0e0;
    border: none;
    border-top-right-radius: 2px;
    min-width: 12px;
    image: url("imgs/up_arrow_light.png");
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: #e0e0e0;
    border: none;
    border-bottom-right-radius: 2px;
    min-width: 12px;
    image: url("imgs/down_arrow_light.png");
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #cce4ff;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow,
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    width: 8px;
    height: 8px;
}

QSpinBox:disabled, QDoubleSpinBox:disabled {
    color: #bdbdbd;
    background-color: #f5f5f5;
    border: 1px solid #e0e0e0;
    selection-color: transparent;
    color: transparent;
}